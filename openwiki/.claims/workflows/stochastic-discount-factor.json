          "version": "repo-lines-v1:sha256:59ac4b22a7858afa379583df604003dddaecb619314af2261cfedeab28b2350f:"
        }
      ]
    },
    {
      "id": "claim_42931de7fbd14c10868c24f8c5305c8d",
      "statement": "The SDF is constructed per date as one minus the cross-sectional sum of weight-times-return, and both unconditional and conditional objectives mask invalid observations, normalize moments by per-asset valid counts, and downweight sparsely observed assets.",
