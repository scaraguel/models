    {
      "id": "claim_044992434d174028b464b374dd95fe99",
      "statement": "StochasticDiscountFactorModel trains a weight-native structural model in three ordered phases: unconditional SDF optimization, adversarial moment-network optimization with the SDF frozen, and conditional SDF optimization with the best adversarial moment state frozen.",
      "evidence": [
        {
          "resource": "repo://src/ml4t/models/_internal/stochastic_discount_factor_nn.py#L204-L271",
          "version": "repo-lines-v1:sha256:cb8617398685639edb00d102d3fffe5cc6aef7fbde8d34a3008fe65a0842dd31:"
