    {
      "id": "claim_6b13eea4a8694d3a8881e99705ff412b",
      "statement": "LatentFactorForecastPipeline.fit first fits the structural model, then extracts a LatentFactorState from the same training batch and fits the factor forecaster on that state; predict separately extracts the target state, forecasts factor premia, maps them to assets, and returns all three outputs.",
